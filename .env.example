# ClaimSense AI - Environment Configuration

# Flask Configuration
FLASK_APP=backend/app.py
FLASK_ENV=development
FLASK_DEBUG=True
PORT=5000
HOST=127.0.0.1
SECRET_KEY=claimsense-ai-dev-secret-key-change-in-production

# Upload Settings
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216  # 16 MB max upload size

# Database Configuration
DATABASE_PATH=backend/database/claimsense.db

# LLM Configuration (Placeholder for Phase 9)
LLM_PROVIDER=mock  # Options: mock, gemini, openai
LLM_API_KEY=

# Risk Scoring Thresholds (Phase 8)
RISK_THRESHOLD_LOW=30
RISK_THRESHOLD_MEDIUM=60
