# ==========================================
# PYTHON VIRTUAL ENVIRONMENT
# ==========================================
.venv/
venv/
ENV/
env/

# ==========================================
# PYTHON CACHE & TESTING
# ==========================================
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ==========================================
# ENVIRONMENT VARIABLES / SECRETS
# ==========================================
.env
.env.*
!.env.example

# ==========================================
# USER UPLOADS AND CLAIM EVIDENCE
# ==========================================
uploads/*
!uploads/.gitkeep

# ==========================================
# GENERATED REPORTS
# ==========================================
reports/*
!reports/.gitkeep

# ==========================================
# MODEL WEIGHTS & CHECKPOINTS
# ==========================================
*.pth
*.pt
*.h5
*.onnx
*.weights
models/*
!models/.gitkeep
runs/**/weights/

# ==========================================
# RESEARCH DATASETS & IMAGES
# Keep manifests, reports, documentation
# ==========================================
datasets/FUNSD/
datasets/SROIE/
datasets/CarDD/
datasets/CarDD_300/
datasets/CarDD_Expanded_v1/
datasets/domain_adaptation_dev/
datasets/exp01_dataset/
datasets/exp02_dataset/
datasets/exp03_dataset/
datasets/**/images/
datasets/**/annotations/
datasets/**/labels/
datasets/**/processed/
datasets/**/provenance/
datasets/**/raw_restricted/
datasets/**/rejected/
datasets/**/batch_01/
datasets/**/batch_02/
datasets/**/archive/
!datasets/README.md
!datasets/.gitkeep
!datasets/**/manifests/

# ==========================================
# TRAINING ARTIFACTS & RAW RUN IMAGES
# Keep reports, metrics, CSVs, and JSONs
# ==========================================
runs/**/*.jpg
runs/**/*.jpeg
runs/**/*.png
runs/detect/
runs/**/dataset_staging/
runs/**/gate_o_staging/
scratch/

# ==========================================
# LOCAL DATA AND SAMPLE CLAIMS
# ==========================================
data/sample_claims/*
!data/sample_claims/.gitkeep

# ==========================================
# DATABASE FILES
# ==========================================
*.db
*.sqlite
*.sqlite3
*.db-wal
*.db-shm

# ==========================================
# BACKUPS, LOGS & TEMPORARY FILES
# ==========================================
backups/
*.bak
*.backup
*.log
logs/
temp/
tmp/

# ==========================================
# IDE / EDITOR & OS
# ==========================================
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini
